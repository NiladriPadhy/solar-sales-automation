flowchart LR
    subgraph sources["Lead sources"]
        referral["Referral"]
        registration["Registration"]
        website["Web enquiry"]
        campaign["Campaign / partner"]
        outbound["Rep calls new number"]
    end

    subgraph intake["Reliable intake"]
        validate["Authorize, validate and normalize"]
        dedupe{"Lead exists in workspace?"}
        upsert["Create or enrich canonical lead"]
        outbox["Commit lead + event atomically"]
    end

    subgraph realtime["Real-time operating loop"]
        stream["Workspace event stream"]
        rules["Assignment + SLA engine"]
        rep["Rep app: accept and act"]
        manager["Manager: monitor and intervene"]
        outcome["Disposition + required next action"]
    end

    subgraph lifecycle["Solar opportunity lifecycle"]
        qualify["Qualified"]
        survey["Survey scheduled"]
        surveyDone["Survey completed"]
        selectItems["Select catalogue items and mapped prices"]
        priceReview{"Any price override?"}
        override["Record quoted price, reason and actor"]
        quoteDraft["Versioned quotation draft"]
        approve["Validate and approve locked revision"]
        html["Render deterministic HTML and PDF"]
        whatsapp["Share PDF via WhatsApp Business"]
        delivery["Track sent, delivered, read or failed"]
        decision{"Customer decision"}
        finance["Finance approval"]
        won["Won + installation handoff"]
        nurture["Nurture / retry"]
        lost["Lost with reason"]
    end

    subgraph recovery["Operational safety"]
        offline["Encrypted mobile outbox"]
        retry["Retry + dead letter"]
        reconcile["Cursor resume + API reconciliation"]
        audit[("Versioned event and audit store")]
    end

    referral --> validate
    registration --> validate
    website --> validate
    campaign --> validate
    outbound --> validate
    validate --> dedupe
    dedupe -->|"No"| upsert
    dedupe -->|"Yes"| upsert
    upsert --> outbox
    outbox --> stream
    outbox --> audit
    stream --> rules
    rules -->|"LeadAssigned + SLA started"| rep
    rules -->|"Queue + countdown"| manager
    rep -->|"Accept, call, message or visit"| outcome
    outcome --> stream
    outcome -->|"Need and intent confirmed"| qualify
    outcome -->|"Callback / no answer"| nurture
    outcome -->|"Disqualified"| lost
    qualify --> survey
    survey --> surveyDone
    surveyDone --> selectItems
    selectItems --> priceReview
    priceReview -->|"No"| quoteDraft
    priceReview -->|"Yes"| override
    override --> quoteDraft
    quoteDraft --> approve
    approve --> html
    html --> whatsapp
    whatsapp --> delivery
    delivery --> decision
    decision -->|"Revise"| quoteDraft
    decision -->|"Finance needed"| finance
    decision -->|"Accepted"| won
    decision -->|"Deferred"| nurture
    decision -->|"Rejected"| lost
    finance -->|"Approved"| won
    finance -->|"Revise terms"| quoteDraft
    nurture -->|"Task due"| rep
    rep -.->|"Offline writes"| offline
    offline -.->|"Idempotent sync"| outbox
    outbox -.->|"Transient / permanent failure"| retry
    retry -.-> outbox
    stream -.->|"Reconnect or version gap"| reconcile
    reconcile -.-> upsert
